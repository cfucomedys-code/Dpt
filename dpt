cat > $PREFIX/bin/dpt << 'ENDOFDPT'
#!/data/data/com.termux/files/usr/bin/bash
set -u

BASE="${HOME}/.srctmh-dpt"
CONFIG="${BASE}/config"
TMP_BASE="${BASE}/tmp"
CREDITS_FILE="${BASE}/credits.dat"
OUTPUT_FOLDER="@ABHI BHAI"
TOOL_VERSION="3.1.0"
FB_URL="https://abhi-bhai-fa85a-default-rtdb.firebaseio.com"
FREE_CREDITS_ON_FIRST_USE=50
ADMIN_TG="https://t.me/abhishekcrack"

if [ -t 1 ]; then
  BOLD=$'\033[1m'; RESET=$'\033[0m'
  GREEN=$'\033[32m'; RED=$'\033[31m'
  CYAN=$'\033[36m'; YELLOW=$'\033[33m'
  MAGENTA=$'\033[35m'; DIM=$'\033[2m'; WHITE=$'\033[37m'
else
  BOLD=""; RESET=""; GREEN=""; RED=""; CYAN=""; YELLOW=""; MAGENTA=""; DIM=""; WHITE=""
fi

BW=36
box_top(){ printf "%s╔══════════════════════════════════════╗%s\n" "$CYAN" "$RESET"; }
box_bot(){ printf "%s╚══════════════════════════════════════╝%s\n" "$CYAN" "$RESET"; }
box_mid(){ printf "%s╠══════════════════════════════════════╣%s\n" "$CYAN" "$RESET"; }
box_line(){
  local raw="$1" vis len pad sp i=0
  vis=$(printf '%s' "$raw" | sed -E 's/\x1b\[[0-9;]*m//g')
  len=${#vis}
  if [ "$len" -gt "$BW" ]; then vis="${vis:0:$((BW-1))}…"; raw="$vis"; len=${#vis}; fi
  pad=$((BW-len)); sp=""
  while [ "$i" -lt "$pad" ]; do sp="$sp "; i=$((i+1)); done
  printf "%s║%s %s%s %s║%s\n" "$CYAN" "$RESET" "$raw" "$sp" "$CYAN" "$RESET"
}
clear_screen(){ clear 2>/dev/null || true; }

read_input(){
  local prompt="${1:- > }" value=""
  printf "%s" "$prompt" >&2
  if [ -r /dev/tty ]; then
    if read -r value </dev/tty; then printf '%s' "$value"; return 0; fi
  fi
  if read -r value; then printf '%s' "$value"; return 0; fi
  printf ''; return 1
}

pause(){
  echo
  printf " %sPress %sEnter%s%s...%s " "$DIM" "$BOLD" "$RESET" "$DIM" "$RESET" >&2
  if [ -r /dev/tty ]; then read -r _ </dev/tty || true; else read -r _ || true; fi
}

on_interrupt(){
  echo; echo
  box_top
  box_line "${YELLOW}Exiting safely${RESET}"
  box_line "${BOLD}${MAGENTA}@ABHI BHAI CRACKER${RESET}"
  box_bot
  echo
  exit 130
}
trap on_interrupt INT TERM

get_device_id(){
  local aid raw hex
  aid=$(getprop ro.serialno 2>/dev/null || true)
  [ -z "$aid" ] || [ "$aid" = "unknown" ] && aid=$(getprop ro.boot.serialno 2>/dev/null || true)
  [ -z "$aid" ] && aid=$(cat /data/data/com.termux/files/usr/etc/uuid 2>/dev/null || true)
  [ -z "$aid" ] && aid="UNKNOWN"
  raw="${aid}-${PREFIX:-$HOME}-ABHIBHAI"
  hex=$(printf '%s' "$raw" | md5sum 2>/dev/null | awk '{print $1}' | head -c 6 | tr 'a-f' 'A-F')
  [ -z "$hex" ] && hex=$(printf '%s' "$raw" | cksum | awk '{print $1}' | head -c 6)
  printf 'ABHI-%s\n' "$hex"
}

fb_get(){ curl -fsS --connect-timeout 6 --max-time 12 "${FB_URL}/$1.json" 2>/dev/null || echo ""; }
fb_put(){ curl -fsS --connect-timeout 6 --max-time 12 -X PUT -H "Content-Type: application/json" -d "$2" "${FB_URL}/$1.json" >/dev/null 2>&1; }
fb_patch(){ curl -fsS --connect-timeout 6 --max-time 12 -X PATCH -H "Content-Type: application/json" -d "$2" "${FB_URL}/$1.json" >/dev/null 2>&1; }

load_local_credits(){
  mkdir -p "$BASE"
  if [ ! -f "$CREDITS_FILE" ]; then
    DEVICE_ID=$(get_device_id)
    CREDITS=$FREE_CREDITS_ON_FIRST_USE
    CREATED=$(date +%s)
    REGISTERED=0
    save_local_credits
  fi
  . "$CREDITS_FILE"
  DEVICE_ID="${device_id:-$(get_device_id)}"
  CREDITS="${credits:-0}"
  CREATED="${created:-$(date +%s)}"
  REGISTERED="${registered:-0}"
  case "$CREDITS" in (*[!0-9]*|"") CREDITS=0 ;; esac
}

save_local_credits(){
  cat > "$CREDITS_FILE" <<EOF
device_id=${DEVICE_ID}
credits=${CREDITS}
created=${CREATED}
registered=${REGISTERED:-0}
EOF
}

sync_from_firebase(){
  local json user_credits user_status
  json=$(fb_get "users/${DEVICE_ID}")
  if [ -z "$json" ] || [ "$json" = "null" ]; then
    if [ "$REGISTERED" = "0" ]; then
      CREATED=$(date +%s)
      fb_put "users/${DEVICE_ID}" "{\"credits\":${CREDITS},\"status\":\"active\",\"device_id\":\"${DEVICE_ID}\",\"created_at\":${CREATED}}"
      REGISTERED=1
      save_local_credits
    fi
    return 0
  fi
  user_credits=$(printf '%s' "$json" | grep -oE '"credits"[[:space:]]*:[[:space:]]*[0-9]+' | head -1 | grep -oE '[0-9]+' | head -1)
  user_status=$(printf '%s' "$json" | grep -oE '"status"[[:space:]]*:[[:space:]]*"[^"]+"' | head -1 | sed -E 's/.*"([^"]+)".*/\1/')
  if [ "$user_status" = "banned" ]; then
    clear_screen
    box_top
    box_line "${RED}${BOLD}ACCESS DENIED${RESET}"
    box_line "${BOLD}${MAGENTA}@ABHI BHAI CRACKER${RESET}"
    box_mid
    box_line "Aapka account banned hai"
    box_line "Contact: ${CYAN}${ADMIN_TG}${RESET}"
    box_bot
    echo
    exit 1
  fi
  if [ -n "$user_credits" ] && [ "$user_credits" != "$CREDITS" ]; then
    CREDITS="$user_credits"
    save_local_credits
  fi
}

sync_to_firebase(){
  fb_patch "users/${DEVICE_ID}" "{\"credits\":${CREDITS},\"status\":\"active\",\"device_id\":\"${DEVICE_ID}\",\"last_seen\":$(date +%s)}"
}

require_config(){
  if [ ! -f "$CONFIG" ]; then
    clear_screen
    box_top; box_line "${RED}${BOLD}NOT INSTALLED${RESET}"; box_mid
    box_line "Run installer first"; box_bot
    echo
    printf "  cd %s/Dpt && bash install.sh\n\n" "$HOME"
    exit 1
  fi
  . "$CONFIG"
  if [ -z "${DPT_JAR:-}" ] || [ ! -f "${DPT_JAR}" ]; then
    clear_screen; box_top; box_line "${RED}${BOLD}ENGINE MISSING${RESET}"; box_mid
    box_line "Re-run install.sh to repair"; box_bot; echo; exit 1
  fi
  if [ -z "${DPT_RUNTIME:-}" ] || [ ! -d "${DPT_RUNTIME}" ]; then
    clear_screen; box_top; box_line "${RED}${BOLD}RUNTIME MISSING${RESET}"; box_mid
    box_line "Re-run install.sh to repair"; box_bot; echo; exit 1
  fi
}

unique_output_name(){
  local dir="$1" base="$2" ext="$3" candidate n=1
  candidate="${dir}/${base}.${ext}"
  [ ! -e "$candidate" ] && { printf '%s\n' "$candidate"; return; }
  while [ -e "${dir}/${base}(${n}).${ext}" ]; do n=$((n+1)); done
  printf '%s\n' "${dir}/${base}(${n}).${ext}"
}

show_protect_progress(){
  local stage="$1" s1 s2 s3 s4 s5
  s1="${DIM}○${RESET}"; s2="${DIM}○${RESET}"; s3="${DIM}○${RESET}"; s4="${DIM}○${RESET}"; s5="${DIM}○${RESET}"
  [ "$stage" -ge 1 ] && s1="${GREEN}✓${RESET}"
  [ "$stage" -ge 2 ] && s2="${GREEN}✓${RESET}"
  [ "$stage" -ge 3 ] && s3="${GREEN}✓${RESET}"
  [ "$stage" -ge 4 ] && s4="${GREEN}✓${RESET}"
  [ "$stage" -ge 5 ] && s5="${GREEN}✓${RESET}"
  if [ "$stage" -eq 0 ]; then s1="${CYAN}●${RESET}"
  elif [ "$stage" -eq 1 ]; then s2="${CYAN}●${RESET}"
  elif [ "$stage" -eq 2 ]; then s3="${CYAN}●${RESET}"
  elif [ "$stage" -eq 3 ]; then s4="${CYAN}●${RESET}"
  elif [ "$stage" -eq 4 ]; then s5="${CYAN}●${RESET}"
  fi
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}PROTECTING${RESET}"
  box_line "${BOLD}${MAGENTA}@ABHI BHAI CRACKER${RESET}"
  box_line "${BOLD}${YELLOW}ADMIN${RESET}"
  box_mid
  box_line "${s1} File verified"
  box_line "${s2} Workspace ready"
  box_line "${s3} Building protection"
  box_line "${s4} Signing package"
  box_line "${s5} Finishing"
  box_bot
}

credits_over_screen(){
  clear_screen
  box_top
  box_line "${RED}${BOLD}CREDITS OVER${RESET}"
  box_line "${BOLD}${MAGENTA}@ABHI BHAI CRACKER${RESET}"
  box_line "${BOLD}${YELLOW}ADMIN${RESET}"
  box_mid
  box_line "Aapke credits khatam ho gaye hain"
  box_line ""
  box_line "Credits lene ke liye contact:"
  box_line "${CYAN}${ADMIN_TG}${RESET}"
  box_bot
  echo
  printf "  %sYour ID:%s %s\n" "$BOLD" "$RESET" "$DEVICE_ID"
  printf "  %sYe ID admin ko bhejo%s\n" "$DIM" "$RESET"
  echo
  pause
}

main_menu(){
  while true; do
    load_local_credits
    sync_from_firebase
    clear_screen
    local choice
    box_top
    box_line "${BOLD}${CYAN}⚡ ABHI BHAI DPT${RESET}"
    box_line "${BOLD}${MAGENTA}@ABHI BHAI CRACKER${RESET}"
    box_line "${BOLD}${YELLOW}ADMIN${RESET}"
    box_line "ID       ${CYAN}${DEVICE_ID}${RESET}"
    box_line "Credits  ${GREEN}${BOLD}${CREDITS}${RESET}"
    box_bot
    echo
    printf " %s[1]%s Protect   %s[2]%s Exit\n" "$CYAN" "$RESET" "$RED" "$RESET"
    echo
    choice=$(read_input " ${BOLD}Select:${RESET} ")
    choice=$(printf '%s' "$choice" | tr -d '[:space:]')
    case "$choice" in
      1) protect_flow ;;
      2)
        clear_screen
        box_top
        box_line "${CYAN}Thanks for using ABHI BHAI DPT${RESET}"
        box_line "${BOLD}${MAGENTA}@ABHI BHAI CRACKER${RESET}"
        box_bot
        echo
        exit 0
        ;;
      "") ;;
      *) printf "  %sInvalid option — choose 1-2%s\n" "$YELLOW" "$RESET" >&2; sleep 1 ;;
    esac
  done
}

protect_flow(){
  load_local_credits
  sync_from_firebase
  if [ "$CREDITS" -le 0 ]; then
    credits_over_screen
    return
  fi
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}PROTECT APK / AAB${RESET}"
  box_line "${BOLD}${MAGENTA}@ABHI BHAI CRACKER${RESET}"
  box_line "Credits left: ${GREEN}${CREDITS}${RESET}"
  box_bot
  echo
  local apk_path
  apk_path=$(read_input " ${GREEN}>${RESET} ")
  apk_path="${apk_path#\"}"; apk_path="${apk_path%\"}"
  apk_path="${apk_path#\'}"; apk_path="${apk_path%\'}"
  case "$apk_path" in "~/"*) apk_path="${HOME}/${apk_path#~/}" ;; esac
  if [ -z "$apk_path" ]; then
    clear_screen; box_top; box_line "${RED}No path entered${RESET}"; box_bot; pause; return
  fi
  if [ ! -f "$apk_path" ]; then
    clear_screen; box_top; box_line "${RED}File not found${RESET}"; box_line "$apk_path"; box_bot; pause; return
  fi
  case "${apk_path,,}" in
    *.apk|*.aab) ;;
    *) clear_screen; box_top; box_line "${RED}Only APK or AAB allowed${RESET}"; box_bot; pause; return ;;
  esac
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}SELECT PROTECTION${RESET}"
  box_line "${BOLD}${MAGENTA}@ABHI BHAI CRACKER${RESET}"
  box_mid
  box_line "${GREEN}[1]${RESET} Normal Protection"
  box_line "    ${DIM}Cost: 1 credit${RESET}"
  box_line ""
  box_line "${CYAN}[2]${RESET} Signature Verification"
  box_line "    ${DIM}Cost: 2 credits${RESET}"
  box_line ""
  box_line "${MAGENTA}[3]${RESET} ABHI BHAI CRACKER PROTECTION"
  box_line "    ${DIM}Cost: 3 credits${RESET}"
  box_bot
  echo
  local ptype_choice ptype_label extra_flags=() cost=1
  ptype_choice=$(read_input " ${BOLD}Select:${RESET} ")
  ptype_choice=$(printf '%s' "$ptype_choice" | tr -d '[:space:]')
  ptype_label="Normal Protection"
  case "$ptype_choice" in
    2) extra_flags+=("-vs"); ptype_label="Signature Verification"; cost=2 ;;
    3) extra_flags+=("-vs"); ptype_label="ABHI BHAI CRACKER PROTECTION"; cost=3 ;;
  esac
  if [ "$CREDITS" -lt "$cost" ]; then
    clear_screen
    box_top
    box_line "${YELLOW}Not enough credits${RESET}"
    box_mid
    box_line "Need: ${cost} credits"
    box_line "Have: ${CREDITS} credits"
    box_line ""
    box_line "Contact: ${CYAN}${ADMIN_TG}${RESET}"
    box_bot
    pause
    return
  fi
  local out_root="${STORAGE_ROOT:-/storage/emulated/0}/${OUTPUT_FOLDER}"
  if ! mkdir -p "$out_root" 2>/dev/null; then
    clear_screen; box_top; box_line "${RED}Cannot create output folder${RESET}"; box_bot; pause; return
  fi
  local apk_name apk_ext apk_base work_dir log_out
  apk_name=$(basename "$apk_path")
  apk_ext="${apk_name##*.}"
  apk_base="${apk_name%.*}"
  work_dir="${TMP_BASE}/protect_$$"
  rm -rf "$work_dir"
  mkdir -p "$work_dir"
  show_protect_progress 0; sleep 0.35
  show_protect_progress 1; sleep 0.35
  show_protect_progress 2; sleep 0.25
  log_out="${work_dir}/run.log"
  (
    cd "$DPT_RUNTIME" || exit 90
    if [ "${#extra_flags[@]}" -gt 0 ]; then
      java -jar "$DPT_JAR" -f "$apk_path" -o "$work_dir" "${extra_flags[@]}"
    else
      java -jar "$DPT_JAR" -f "$apk_path" -o "$work_dir"
    fi
  ) >"$log_out" 2>&1 &
  local eng_pid=$!
  show_protect_progress 3
  local waited=0
  while kill -0 "$eng_pid" 2>/dev/null; do
    sleep 0.4
    waited=$((waited+1))
    [ "$waited" -eq 4 ] && show_protect_progress 4
  done
  wait "$eng_pid"
  local status=$?
  if [ "$status" -ne 0 ]; then
    local reason
    reason=$(tail -n 5 "$log_out" 2>/dev/null | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g' | cut -c1-34)
    [ -z "$reason" ] && reason="Unknown error"
    clear_screen
    box_top
    box_line "${RED}${BOLD}✗ PROTECTION FAILED${RESET}"
    box_line "${BOLD}${MAGENTA}@ABHI BHAI CRACKER${RESET}"
    box_mid
    box_line "Reason: $reason"
    box_bot
    rm -rf "$work_dir"; pause; return
  fi
  show_protect_progress 5; sleep 0.25
  local produced final_path
  produced=$(find "$work_dir" -type f \( -name "*_signed.apk" -o -name "*.apk" -o -name "*.aab" \) ! -name "*_unsign*" -print 2>/dev/null | head -n1)
  if [ -z "$produced" ]; then
    clear_screen; box_top; box_line "${RED}No output file found${RESET}"; box_bot
    rm -rf "$work_dir"; pause; return
  fi
  final_path=$(unique_output_name "$out_root" "$apk_base" "$apk_ext")
  if ! mv "$produced" "$final_path"; then
    clear_screen; box_top; box_line "${RED}Could not save output${RESET}"; box_bot
    rm -rf "$work_dir"; pause; return
  fi
  rm -rf "$work_dir"
  CREDITS=$((CREDITS-cost))
  [ "$CREDITS" -lt 0 ] && CREDITS=0
  save_local_credits
  sync_to_firebase
  clear_screen
  box_top
  box_line "${GREEN}${BOLD}✓ PROTECTION COMPLETE${RESET}"
  box_line "${BOLD}${MAGENTA}@ABHI BHAI CRACKER${RESET}"
  box_line "${BOLD}${YELLOW}ADMIN${RESET}"
  box_mid
  box_line "${WHITE}${apk_name}${RESET}"
  box_line "Mode: ${CYAN}${ptype_label}${RESET}"
  box_line "Credits left: ${GREEN}${CREDITS}${RESET}"
  box_line "Saved to:"
  box_line "${DIM}${final_path}${RESET}"
  box_bot
  if [ "$CREDITS" -le 0 ]; then
    echo
    printf "  %s⚠ Credits khatam%s\n" "$YELLOW" "$RESET"
    printf "  %sContact: %s%s\n" "$DIM" "$ADMIN_TG" "$RESET"
  fi
  pause
}

require_config
main_menu
ENDOFDPT
chmod +x $PREFIX/bin/dpt
