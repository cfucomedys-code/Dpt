# ========== ID GENERATION - MULTI-SOURCE (HAR PHONE ALAG) ==========
get_device_id(){
  local android_id serial_id termux_uuid combined hex

  # Source 1: Android ID (best - unique per device, works on Android 8+)
  android_id=$(settings get secure android_id 2>/dev/null || true)
  if [ -z "$android_id" ] || [ "$android_id" = "null" ]; then
    android_id=""
  fi

  # Source 2: Serial (may be unknown on Android 10+)
  serial_id=$(getprop ro.serialno 2>/dev/null || true)
  if [ -z "$serial_id" ] || [ "$serial_id" = "unknown" ]; then
    serial_id=""
  fi

  # Source 3: Termux UUID (fallback)
  termux_uuid=$(cat /data/data/com.termux/files/usr/etc/uuid 2>/dev/null || true)
  if [ -z "$termux_uuid" ]; then
    termux_uuid="${RANDOM}${RANDOM}${RANDOM}"
  fi

  # Combine all sources
  combined="${android_id}|${serial_id}|${termux_uuid}|ABHIBHAI"

  # Generate 6-char hex hash
  hex=$(printf '%s' "$combined" | md5sum 2>/dev/null | awk '{print $1}' | head -c 6 | tr 'a-f' 'A-F')
  if [ -z "$hex" ]; then
    hex=$(printf '%s' "$combined" | cksum | awk '{print $1}' | head -c 6)
  fi

  printf '%s-%s\n' "$ID_PREFIX" "$hex"
}

fb_get(){ curl -fsS --connect-timeout 6 --max-time 12 "${FB_URL}/$1.json" 2>/dev/null || echo ""; }
fb_put(){ curl -fsS --connect-timeout 6 --max-time 12 -X PUT -H "Content-Type: application/json" -d "$2" "${FB_URL}/$1.json" >/dev/null 2>&1; }
fb_patch(){ curl -fsS --connect-timeout 6 --max-time 12 -X PATCH -H "Content-Type: application/json" -d "$2" "${FB_URL}/$1.json" >/dev/null 2>&1; }

load_local_credits(){
  mkdir -p "$BASE"
  DEVICE_ID=$(get_device_id)

  if [ ! -f "$CREDITS_FILE" ]; then
    CREDITS=$FREE_CREDITS_ON_FIRST_USE
    CREATED=$(date +%s)
    REGISTERED=0
    save_local_credits
  else
    . "$CREDITS_FILE"
    CREDITS="${credits:-0}"
    CREATED="${created:-$(date +%s)}"
    REGISTERED="${registered:-0}"
  fi
  case "$CREDITS" in (*[!0-9]*|"") CREDITS=0 ;; esac
}

save_local_credits(){
  cat > "$CREDITS_FILE" <<EOF
credits=${CREDITS}
created=${CREATED}
registered=${REGISTERED:-0}
EOF
}

sync_from_firebase(){
  local json user_credits user_status
  json=$(fb_get "${K_USERS}/${DEVICE_ID}")
  if [ -z "$json" ] || [ "$json" = "null" ]; then
    if [ "$REGISTERED" = "0" ]; then
      CREATED=$(date +%s)
      fb_put "${K_USERS}/${DEVICE_ID}" "{\"${K_CREDITS}\":${CREDITS},\"${K_STATUS}\":\"${V_ACTIVE}\",\"${K_DEVICE}\":\"${DEVICE_ID}\",\"${K_CREATED}\":${CREATED}}"
      REGISTERED=1
      save_local_credits
    fi
    return 0
  fi
  user_credits=$(printf '%s' "$json" | grep -oE "\"${K_CREDITS}\"[[:space:]]*:[[:space:]]*[0-9]+" | head -1 | grep -oE '[0-9]+' | head -1)
  user_status=$(printf '%s' "$json" | grep -oE "\"${K_STATUS}\"[[:space:]]*:[[:space:]]*\"[^\"]+\"" | head -1 | sed -E 's/.*"([^"]+)".*/\1/')
  if [ "$user_status" = "$V_BANNED" ]; then
    clear_screen
    box_top
    box_line "${RED}${BOLD}ACCESS DENIED${RESET}"
    box_line "${BOLD}${MAGENTA}${BRAND_NAME}${RESET}"
    box_mid
    box_line "Aapka account banned hai"
    box_line "Contact: ${CYAN}${ADMIN_TG}${RESET}"
    box_bot
    echo
    exit 1
  fi
  if [ -n "$user_credits" ] && [ "$user_credits" != "$CREDITS" ]; then
    CREDITS="$user_credits"
    save_local_credits
  fi
}

sync_to_firebase(){
  fb_patch "${K_USERS}/${DEVICE_ID}" "{\"${K_CREDITS}\":${CREDITS},\"${K_STATUS}\":\"${V_ACTIVE}\",\"${K_DEVICE}\":\"${DEVICE_ID}\",\"${K_SEEN}\":$(date +%s)}"
}

require_config(){
  if [ ! -f "$CONFIG" ]; then
    clear_screen
    box_top; box_line "${RED}${BOLD}NOT INSTALLED${RESET}"; box_mid
    box_line "Run installer first"; box_bot
    echo
    printf "  cd %s/Dpt && bash install.sh\n\n" "$HOME"
    exit 1
  fi
  . "$CONFIG"
  if [ -z "${DPT_JAR:-}" ] || [ ! -f "${DPT_JAR}" ]; then
    clear_screen; box_top; box_line "${RED}${BOLD}${M_ENG}${RESET}"; box_mid
    box_line "Re-run install.sh to repair"; box_bot; echo; exit 1
  fi
  if [ -z "${DPT_RUNTIME:-}" ] || [ ! -d "${DPT_RUNTIME}" ]; then
    clear_screen; box_top; box_line "${RED}${BOLD}${M_RT}${RESET}"; box_mid
    box_line "Re-run install.sh to repair"; box_bot; echo; exit 1
  fi
}

unique_output_name(){
  local dir="$1" base="$2" ext="$3" candidate n=1
  candidate="${dir}/${base}.${ext}"
  [ ! -e "$candidate" ] && { printf '%s\n' "$candidate"; return; }
  while [ -e "${dir}/${base}(${n}).${ext}" ]; do n=$((n+1)); done
  printf '%s\n' "${dir}/${base}(${n}).${ext}"
}

show_protect_progress(){
  local stage="$1" s1 s2 s3 s4 s5
  s1="${DIM}○${RESET}"; s2="${DIM}○${RESET}"; s3="${DIM}○${RESET}"; s4="${DIM}○${RESET}"; s5="${DIM}○${RESET}"
  [ "$stage" -ge 1 ] && s1="${GREEN}✓${RESET}"
  [ "$stage" -ge 2 ] && s2="${GREEN}✓${RESET}"
  [ "$stage" -ge 3 ] && s3="${GREEN}✓${RESET}"
  [ "$stage" -ge 4 ] && s4="${GREEN}✓${RESET}"
  [ "$stage" -ge 5 ] && s5="${GREEN}✓${RESET}"
  if [ "$stage" -eq 0 ]; then s1="${CYAN}●${RESET}"
  elif [ "$stage" -eq 1 ]; then s2="${CYAN}●${RESET}"
  elif [ "$stage" -eq 2 ]; then s3="${CYAN}●${RESET}"
  elif [ "$stage" -eq 3 ]; then s4="${CYAN}●${RESET}"
  elif [ "$stage" -eq 4 ]; then s5="${CYAN}●${RESET}"
  fi
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}PROTECTING${RESET}"
  box_line "${BOLD}${MAGENTA}${BRAND_NAME}${RESET}"
  box_line "${BOLD}${YELLOW}ADMIN${RESET}"
  box_mid
  box_line "${s1} File verified"
  box_line "${s2} Workspace ready"
  box_line "${s3} Building protection"
  box_line "${s4} Signing package"
  box_line "${s5} Finishing"
  box_bot
}

