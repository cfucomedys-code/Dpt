    box_line "${MAGENTA}${BOLD}VIP ACCESS${RESET}"
    box_mid
    box_line "${DIM}Device ID${RESET}"
    box_line "${CYAN}${BOLD}${DEVICE_ID}${RESET}"
    box_line "Send this ID to ${BOLD}${MAGENTA}@ABHI BHAI${RESET}"
    box_bot
    echo
    printf " %s[1]%s Show ID   %s[2]%s Enter Key\n" "$CYAN" "$RESET" "$CYAN" "$RESET"
    printf " %s[3]%s Free Credits (Ads)   %s[0]%s Back\n" "$GREEN" "$RESET" "$CYAN" "$RESET"
    echo
    local c
    c=$(read_input " ${BOLD}Select:${RESET} ")
    c=$(printf '%s' "$c" | tr -d '[:space:]')
    case "$c" in
      1)
        echo
        printf "  %s%s%s\n" "$BOLD$CYAN" "$DEVICE_ID" "$RESET"
        copy_to_clipboard "$DEVICE_ID" && printf "  %s(Copied)%s\n" "$GREEN" "$RESET"
        pause
        ;;
      2)
        echo
        local key result ok
        key=$(read_input " ${GREEN}Paste key:${RESET} ")
        if [ -z "$key" ]; then
          clear_screen; box_top; box_line "${RED}No key entered${RESET}"; box_bot; pause; continue
        fi
        result=$(verify_and_activate_key "$key")
        ok=$?
        clear_screen
        if [ "$ok" -eq 0 ]; then
          box_top; box_line "${GREEN}${BOLD}✓ VIP KEY ACTIVATED${RESET}"; box_mid
          box_line "${GREEN}+${result}${RESET} VIP credits added"
          box_line "Total VIP credits: ${MAGENTA}${VIP_CREDITS}${RESET}"
          box_bot; pause; return
        else
          box_top; box_line "${RED}${BOLD}✗ INVALID KEY${RESET}"; box_mid
          case "$result" in
            ALREADY_USED) box_line "Key already used" ;;
            INVALID_FORMAT) box_line "Wrong key format" ;;
            *) box_line "Key wrong or not for this device" ;;
          esac
          box_bot; pause
        fi
        ;;
      3) free_credits_ads ;;
      0|"") return ;;
      *) printf "  %sInvalid option%s\n" "$YELLOW" "$RESET" >&2; sleep 1 ;;
    esac
  done
}

history_screen(){
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}HISTORY${RESET}"
  box_mid
  if [ ! -f "$HISTORY_FILE" ] || [ ! -s "$HISTORY_FILE" ]; then
    box_line "${DIM}No history yet${RESET}"
  else
    local i=0 date name ptype status mark
    while IFS='|' read -r date name ptype status; do
      i=$((i+1)); [ "$i" -gt 8 ] && break
      mark="${GREEN}✓${RESET}"; [ "$status" = "Failed" ] && mark="${RED}✗${RESET}"
      box_line "$i  ${WHITE}${name}${RESET}  ${mark}  ${CYAN}${ptype}${RESET}"
      box_line "   ${DIM}${date}${RESET}"
    done < <(tail -n 8 "$HISTORY_FILE" | tac 2>/dev/null || tail -n 8 "$HISTORY_FILE")
  fi
  box_bot
  echo
  printf " %s[0]%s Back\n" "$CYAN" "$RESET"
  read_input " ${BOLD}Select:${RESET} " >/dev/null
}

update_screen(){
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}UPDATES${RESET}"
  box_mid
  box_line "Tool    ${GREEN}${TOOL_VERSION}${RESET}"
  box_line "Engine  ${DPT_ENGINE_VERSION:-unknown}"
  box_bot
  echo
  printf "  %s[i]%s Checking repo...\n" "$CYAN" "$RESET"
  local json remote
  json=$(curl -fsS --connect-timeout 8 --max-time 12 "$KILL_SWITCH_URL" 2>/dev/null || true)
  remote=$(printf '%s' "$json" | grep -oE '"tool_version"[[:space:]]*:[[:space:]]*"[^"]+"' | head -1 | sed -E 's/.*"tool_version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
  echo
  if [ -z "$remote" ]; then
    printf "  %sCould not check (network)%s\n" "$YELLOW" "$RESET"
  elif [ "$remote" = "$TOOL_VERSION" ]; then
    printf "  %sTool is up to date%s\n" "$GREEN" "$RESET"
  elif ver_gt "$remote" "$TOOL_VERSION"; then
    printf "  Latest: %s%s%s\n" "$CYAN" "$remote" "$RESET"
    printf " %s[1]%s Update now   %s[0]%s Back\n" "$GREEN" "$RESET" "$CYAN" "$RESET"
    local c
    c=$(read_input " ${BOLD}Select:${RESET} ")
    c=$(printf '%s' "$c" | tr -d '[:space:]')
    [ "$c" = "1" ] && apply_self_update
    return
  else
    printf "  Installed version is current.\n"
  fi
  pause
}

