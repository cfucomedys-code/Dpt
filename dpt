#!/data/data/com.termux/files/usr/bin/bash
set -u

BASE="${HOME}/.srctmh-dpt"
TMP_BASE="${BASE}/tmp"
OUTPUT_FOLDER="@ABHI BHAI"
TOOL_VERSION="3.1.0"
KILL_SWITCH_URL="https://raw.githubusercontent.com/cfucomedys-code/Dpt/refs/heads/main/version.json?token=GHSAT0AAAAAAELS76TEKQSYB3SDMPZKFA2A2WHDUHQ"
ENGINE_API="https://api.github.com/repos/luoyesiqiu/dpt-shell/releases/latest"
REPO_RAW="https://raw.githubusercontent.com/cfucomedys-code/Dpt/refs/heads/main/install.sh?token=GHSAT0AAAAAAELS76TETJ4KJXDNZ7ENUBRW2WHFAVA"

if [ -t 1 ]; then
  BOLD=$'\033[1m'; RESET=$'\033[0m'
  GREEN=$'\033[32m'; RED=$'\033[31m'
  CYAN=$'\033[36m'; YELLOW=$'\033[33m'
  MAGENTA=$'\033[35m'; DIM=$'\033[2m'; WHITE=$'\033[37m'
else
  BOLD=""; RESET=""; GREEN=""; RED=""; CYAN=""; YELLOW=""; MAGENTA=""; DIM=""; WHITE=""
fi

BW=36
box_top(){ printf "%s╔══════════════════════════════════════╗%s\n" "$CYAN" "$RESET"; }
box_bot(){ printf "%s╚══════════════════════════════════════╝%s\n" "$CYAN" "$RESET"; }
box_mid(){ printf "%s╠══════════════════════════════════════╣%s\n" "$CYAN" "$RESET"; }
box_line(){
  local raw="$1" vis len pad sp i=0
  vis=$(printf '%s' "$raw" | sed -E 's/\x1b\[[0-9;]*m//g')
  len=${#vis}
  if [ "$len" -gt "$BW" ]; then vis="${vis:0:$((BW-1))}…"; raw="$vis"; len=${#vis}; fi
  pad=$((BW-len)); sp=""
  while [ "$i" -lt "$pad" ]; do sp="$sp "; i=$((i+1)); done
  printf "%s║%s %s%s %s║%s\n" "$CYAN" "$RESET" "$raw" "$sp" "$CYAN" "$RESET"
}
clear_screen(){ clear 2>/dev/null || true; }

read_input(){
  local prompt="${1:- > }"
  local value=""
  printf "%s" "$prompt" >&2
  if [ -r /dev/tty ]; then
    if read -r value </dev/tty; then
      printf '%s' "$value"
      return 0
    fi
  fi
  if read -r value; then
    printf '%s' "$value"
    return 0
  fi
  printf ''
  return 1
}

pause(){
  echo
  printf " %sPress %sEnter%s%s...%s " "$DIM" "$BOLD" "$RESET" "$DIM" "$RESET" >&2
  if [ -r /dev/tty ]; then
    read -r _ </dev/tty || true
  else
    read -r _ || true
  fi
}

on_interrupt(){
  echo; echo
  box_top
  box_line "${YELLOW}Exiting safely${RESET}"
  box_line "Thanks · ${BOLD}${MAGENTA}@ABHI BHAI${RESET}"
  box_bot
  echo
  exit 130
}
trap on_interrupt INT TERM

require_config(){
  if [ ! -f "$CONFIG" ]; then
    clear_screen
    box_top; box_line "${RED}${BOLD}NOT INSTALLED${RESET}"; box_mid
    box_line "Run installer first"; box_bot
    echo
    printf "  pkg install git -y\n"
    printf "  git clone https://github.com/srctmh/dpt.git && cd dpt && bash install.sh\n\n"
    exit 1
  fi
  . "$CONFIG"
  if [ -z "${DPT_JAR:-}" ] || [ ! -f "${DPT_JAR}" ]; then
    clear_screen
    box_top; box_line "${RED}${BOLD}ENGINE MISSING${RESET}"; box_mid
    box_line "Re-run install.sh to repair"; box_bot
    echo; exit 1
  fi
  if [ -z "${DPT_RUNTIME:-}" ] || [ ! -d "${DPT_RUNTIME}" ]; then
    clear_screen
    box_top; box_line "${RED}${BOLD}ENGINE RUNTIME MISSING${RESET}"; box_mid
    box_line "Re-run install.sh to repair"; box_bot
    echo; exit 1
  fi
}

ver_gt(){
  local a="$1" b="$2"
  [ "$a" = "$b" ] && return 1
  printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1 | grep -qx "$a"
}

check_kill_and_update(){
  local json status msg remote force
  json=$(curl -fsS --connect-timeout 5 --max-time 8 "$KILL_SWITCH_URL" 2>/dev/null || true)
  [ -z "$json" ] && return 0
  status=$(printf '%s' "$json" | grep -oE '"status"[[:space:]]*:[[:space:]]*"[^"]+"' | head -1 | sed -E 's/.*"status"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
  if [ "$status" = "disabled" ]; then
    msg=$(printf '%s' "$json" | grep -oE '"message"[[:space:]]*:[[:space:]]*"[^"]+"' | head -1 | sed -E 's/.*"message"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
    clear_screen
    box_top; box_line "${RED}${BOLD}SERVICE UNAVAILABLE${RESET}"; box_mid
    box_line "${msg:-Temporarily disabled}"
    box_line "Contact ${MAGENTA}@ABHI BHAI${RESET}"
    box_bot; echo; exit 1
  fi
  remote=$(printf '%s' "$json" | grep -oE '"tool_version"[[:space:]]*:[[:space:]]*"[^"]+"' | head -1 | sed -E 's/.*"tool_version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
  force=$(printf '%s' "$json" | grep -oE '"force_update"[[:space:]]*:[[:space:]]*[^,}]+' | head -1 | sed -E 's/.*:[[:space:]]*//' | tr -d ' "')
  if [ -n "$remote" ] && ver_gt "$remote" "$TOOL_VERSION"; then
    clear_screen
    box_top
    box_line "${YELLOW}${BOLD}UPDATE AVAILABLE${RESET}"
    box_mid
    box_line "Installed : ${TOOL_VERSION}"
    box_line "Latest    : ${remote}"
    box_line "Repo update mil chuka hai"
    box_bot
    echo
    printf " %s[1]%s Update now   %s[0]%s Later\n" "$GREEN" "$RESET" "$CYAN" "$RESET"
    echo
    local c
    c=$(read_input " ${BOLD}Select:${RESET} ")
    c=$(printf '%s' "$c" | tr -d '[:space:]')
    if [ "$c" = "1" ] || [ "$force" = "true" ]; then
      apply_self_update
    fi
  fi
}

apply_self_update(){
  clear_screen
  box_top; box_line "${CYAN}${BOLD}UPDATING${RESET}"; box_mid
  box_line "Downloading latest files..."; box_bot
  echo
  local tmpd newd newi
  tmpd=$(mktemp -d 2>/dev/null || echo "${TMP_BASE}/upd$$")
  mkdir -p "$tmpd"
  newd="${tmpd}/dpt"; newi="${tmpd}/install.sh"
  if curl -fL --retry 3 --connect-timeout 15 "${REPO_RAW}/dpt" -o "$newd" 2>/dev/null && [ -s "$newd" ]; then
    if grep -q "subprocess.call" "$newd" 2>/dev/null && head -n 8 "$newd" | grep -q "python3"; then
      box_top; box_line "${RED}Update file invalid${RESET}"; box_bot; rm -rf "$tmpd"; pause; return
    fi
    chmod 755 "$newd"
    mkdir -p "${PREFIX}/bin"
    cp "$newd" "${PREFIX}/bin/dpt"
    chmod 755 "${PREFIX}/bin/dpt"
  fi
  if curl -fL --retry 3 --connect-timeout 15 "${REPO_RAW}/install.sh" -o "$newi" 2>/dev/null && [ -s "$newi" ]; then
    printf "  %s[i]%s Latest installer downloaded.\n" "$CYAN" "$RESET"
    printf "  Re-run if engine also needs refresh:\n"
    printf "  %sbash install.sh%s\n" "$BOLD" "$RESET"
  fi
  rm -rf "$tmpd"
  echo
  box_top; box_line "${GREEN}UPDATE APPLIED${RESET}"; box_mid
  box_line "Restart tool: type dpt"; box_bot
  echo
  exit 0
}

unique_output_name(){
  local dir="$1" base="$2" ext="$3" candidate n=1
  candidate="${dir}/${base}.${ext}"
  [ ! -e "$candidate" ] && { printf '%s\n' "$candidate"; return; }
  while [ -e "${dir}/${base}(${n}).${ext}" ]; do n=$((n+1)); done
  printf '%s\n' "${dir}/${base}(${n}).${ext}"
}

show_protect_progress(){
  local stage="$1" s1 s2 s3 s4 s5
  s1="${DIM}○${RESET}"; s2="${DIM}○${RESET}"; s3="${DIM}○${RESET}"; s4="${DIM}○${RESET}"; s5="${DIM}○${RESET}"
  [ "$stage" -ge 1 ] && s1="${GREEN}✓${RESET}"
  [ "$stage" -ge 2 ] && s2="${GREEN}✓${RESET}"
  [ "$stage" -ge 3 ] && s3="${GREEN}✓${RESET}"
  [ "$stage" -ge 4 ] && s4="${GREEN}✓${RESET}"
  [ "$stage" -ge 5 ] && s5="${GREEN}✓${RESET}"
  if [ "$stage" -eq 0 ]; then s1="${CYAN}●${RESET}"
  elif [ "$stage" -eq 1 ]; then s2="${CYAN}●${RESET}"
  elif [ "$stage" -eq 2 ]; then s3="${CYAN}●${RESET}"
  elif [ "$stage" -eq 3 ]; then s4="${CYAN}●${RESET}"
  elif [ "$stage" -eq 4 ]; then s5="${CYAN}●${RESET}"
  fi
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}PROTECTING${RESET}"
  box_mid
  box_line "${s1} File verified"
  box_line "${s2} Workspace ready"
  box_line "${s3} Building protection"
  box_line "${s4} Signing package"
  box_line "${s5} Finishing"
  box_bot
}

main_menu(){
  while true; do
    clear_screen
    local choice
    box_top
    box_line "${BOLD}${CYAN}⚡ SRC TMH DPT${RESET}"
    box_line "Plan     ${GREEN}${BOLD}Unlimited${RESET}"
    box_line "Status   ${GREEN}Active${RESET}"
    box_bot
    echo
    printf " %s[1]%s Protect   %s[2]%s About     %s[3]%s %sExit%s\n" \
      "$CYAN" "$RESET" "$CYAN" "$RESET" "$CYAN" "$RESET" "$RED" "$RESET"
    echo
    choice=$(read_input " ${BOLD}Select:${RESET} ")
    choice=$(printf '%s' "$choice" | tr -d '[:space:]')
    case "$choice" in
      1) protect_flow ;;
      2) about_screen ;;
      3)
        clear_screen
        box_top
        box_line "${CYAN}Thanks for using SRC TMH DPT${RESET}"
        box_line "Developed by ${BOLD}${MAGENTA}@SRCTMH${RESET}"
        box_bot
        echo
        exit 0
        ;;
      "") ;;
      *)
        printf "  %sInvalid option — choose 1-3%s\n" "$YELLOW" "$RESET" >&2
        sleep 1
        ;;
    esac
  done
}

about_screen(){
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}ABOUT${RESET}"
  box_mid
  box_line "SRC TMH DPT v${TOOL_VERSION}"
  box_line "APK/AAB Protection Tool"
  box_line "Powered by dpt-shell"
  box_line "Dev: ${MAGENTA}@ABHI BHAI${RESET}"
  box_bot
  pause
}

protect_flow(){
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}PROTECT APK / AAB${RESET}"
  box_line "${DIM}Enter file path below${RESET}"
  box_bot
  echo
  local apk_path
  apk_path=$(read_input " ${GREEN}>${RESET} ")
  apk_path="${apk_path#\"}"; apk_path="${apk_path%\"}"
  apk_path="${apk_path#\'}"; apk_path="${apk_path%\'}"
  case "$apk_path" in "~/"*) apk_path="${HOME}/${apk_path#~/}" ;; esac
  if [ -z "$apk_path" ]; then
    clear_screen; box_top; box_line "${RED}No path entered${RESET}"; box_bot; pause; return
  fi
  if [ ! -f "$apk_path" ]; then
    clear_screen; box_top; box_line "${RED}File not found${RESET}"; box_line "$apk_path"; box_bot; pause; return
  fi
  case "${apk_path,,}" in
    *.apk|*.aab) ;;
    *) clear_screen; box_top; box_line "${RED}Only APK or AAB allowed${RESET}"; box_bot; pause; return ;;
  esac

  clear_screen
  box_top
  box_line "${BOLD}${CYAN}SELECT PROTECTION${RESET}"
  box_mid
  box_line "${GREEN}[1]${RESET} Normal Protection"
  box_line "${MAGENTA}[2]${RESET} Signature Verification"
  box_bot
  echo
  local ptype_choice mode ptype_label
  ptype_choice=$(read_input " ${BOLD}Select:${RESET} ")
  ptype_choice=$(printf '%s' "$ptype_choice" | tr -d '[:space:]')
  local extra_flags=()
  mode="normal"; ptype_label="Normal"
  case "$ptype_choice" in
    2) mode="signature"; extra_flags+=("-vs"); ptype_label="Signature" ;;
    *) mode="normal"; ptype_label="Normal" ;;
  esac

  local out_root="${STORAGE_ROOT:-/storage/emulated/0}/${OUTPUT_FOLDER}"
  if ! mkdir -p "$out_root" 2>/dev/null; then
    clear_screen; box_top; box_line "${RED}Cannot create @SRCTMH folder${RESET}"; box_bot; pause; return
  fi

  local apk_name apk_base apk_ext work_dir log_out
  apk_name=$(basename "$apk_path")
  apk_ext="${apk_name##*.}"
  apk_base="${apk_name%.*}"
  work_dir="${TMP_BASE}/protect_$$"
  rm -rf "$work_dir"
  mkdir -p "$work_dir"

  show_protect_progress 0; sleep 0.35
  show_protect_progress 1; sleep 0.35
  show_protect_progress 2; sleep 0.25

  log_out="${work_dir}/run.log"
  (
    cd "$DPT_RUNTIME" || exit 90
    if [ "${#extra_flags[@]}" -gt 0 ]; then
      java -jar "$DPT_JAR" -f "$apk_path" -o "$work_dir" "${extra_flags[@]}"
    else
      java -jar "$DPT_JAR" -f "$apk_path" -o "$work_dir"
    fi
  ) >"$log_out" 2>&1 &
  local eng_pid=$!
  show_protect_progress 3
  local waited=0
  while kill -0 "$eng_pid" 2>/dev/null; do
    sleep 0.4
    waited=$((waited+1))
    [ "$waited" -eq 4 ] && show_protect_progress 4
  done
  wait "$eng_pid"
  local status=$?
  if [ "$status" -ne 0 ]; then
    local reason
    reason=$(tail -n 5 "$log_out" 2>/dev/null | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g' | cut -c1-34)
    [ -z "$reason" ] && reason="Unknown error"
    clear_screen
    box_top; box_line "${RED}${BOLD}✗ PROTECTION FAILED${RESET}"; box_mid
    box_line "Reason: $reason"; box_bot
    rm -rf "$work_dir"; pause; return
  fi
  show_protect_progress 5; sleep 0.25

  local produced final_path
  produced=$(find "$work_dir" -type f \( -name "*_signed.apk" -o -name "*.apk" -o -name "*.aab" \) ! -name "*_unsign*" -print 2>/dev/null | head -n1)
  if [ -z "$produced" ]; then
    clear_screen; box_top; box_line "${RED}No output file found${RESET}"; box_bot
    rm -rf "$work_dir"; pause; return
  fi
  final_path=$(unique_output_name "$out_root" "$apk_base" "$apk_ext")
  if ! mv "$produced" "$final_path"; then
    clear_screen; box_top; box_line "${RED}Could not save output${RESET}"; box_bot
    rm -rf "$work_dir"; pause; return
  fi
  rm -rf "$work_dir"

  clear_screen
  box_top
  box_line "${GREEN}${BOLD}✓ PROTECTION COMPLETE${RESET}"
  box_mid
  box_line "${WHITE}${apk_name}${RESET} · ${CYAN}${ptype_label}${RESET}"
  box_line "Saved to:"
  box_line "${DIM}${final_path}${RESET}"
  box_bot
  pause
}

# Main entry
require_config
check_kill_and_update
main_menu
