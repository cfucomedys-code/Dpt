  if ! printf '%s' "$key" | grep -qE '^SRCTMH-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$'; then
    echo "INVALID_FORMAT"; return 1
  fi
  mkdir -p "$BASE"
  if [ -f "$ACTIVATED_FILE" ] && grep -qxF "$key" "$ACTIVATED_FILE" 2>/dev/null; then
    echo "ALREADY_USED"; return 1
  fi
  credits=$(decode_credits_from_key "$key")
  [ -z "$credits" ] && { echo "INVALID_KEY"; return 1; }
  case "$credits" in (*[!0-9]*) echo "INVALID_KEY"; return 1 ;; esac
  [ "$credits" -lt 1 ] && { echo "INVALID_KEY"; return 1; }
  VIP_CREDITS=$((VIP_CREDITS + credits))
