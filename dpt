    echo
    choice=$(read_input " ${BOLD}Select:${RESET} ")
    choice=$(printf '%s' "$choice" | tr -d '[:space:]')
    case "$choice" in
      1) protect_flow ;;
      2)
        clear_screen
        box_top
        box_line "${CYAN}Thanks for using ${TOOL_NAME}${RESET}"
        box_line "${BOLD}${MAGENTA}${BRAND_NAME}${RESET}"
        box_bot
        echo
        exit 0
        ;;
      "") ;;
      *) printf "  %sInvalid option — choose 1-2%s\n" "$YELLOW" "$RESET" >&2; sleep 1 ;;
    esac
  done
}

protect_flow(){
  load_local_credits
  sync_from_firebase
  if [ "$CREDITS" -le 0 ]; then
    credits_over_screen
    return
  fi
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}${M_PROTECT}${RESET}"
  box_line "${BOLD}${MAGENTA}${BRAND_NAME}${RESET}"
  box_line "${BOLD}${YELLOW}ADMIN${RESET}"
  box_mid
  box_line "APK file ka path paste karo"
  box_line "${DIM}Example: /sdcard/Download/app.apk${RESET}"
  box_bot
  echo
  local apk_path
  apk_path=$(read_input " ${GREEN}➤ APK ka path paste karo: ${RESET}")
  apk_path="${apk_path#\"}"; apk_path="${apk_path%\"}"
  apk_path="${apk_path#\'}"; apk_path="${apk_path%\'}"
  case "$apk_path" in "~/"*) apk_path="${HOME}/${apk_path#~/}" ;; esac
  if [ -z "$apk_path" ]; then
    clear_screen; box_top; box_line "${RED}No path entered${RESET}"; box_bot; pause; return
  fi
  if [ ! -f "$apk_path" ]; then
    clear_screen; box_top; box_line "${RED}File not found${RESET}"; box_line "$apk_path"; box_bot; pause; return
  fi
  case "${apk_path,,}" in
    *.apk|*.aab) ;;
    *) clear_screen; box_top; box_line "${RED}Only APK or AAB allowed${RESET}"; box_bot; pause; return ;;
  esac
  clear_screen
  box_top
  box_line "${BOLD}${CYAN}SELECT PROTECTION${RESET}"
  box_line "${BOLD}${MAGENTA}${BRAND_NAME}${RESET}"
  box_mid
  box_line "${GREEN}[1]${RESET} ${M_NORMAL}"
  box_line "    ${DIM}${M_COST1}${RESET}"
  box_line ""
  box_line "${CYAN}[2]${RESET} ${M_SIG}"
  box_line "    ${DIM}${M_COST2}${RESET}"
  box_line ""
  box_line "${MAGENTA}[3]${RESET} ${BRAND_NAME} PROTECTION"
  box_line "    ${DIM}${M_COST3}${RESET}"
  box_bot
  echo
  local ptype_choice ptype_label extra_flags=() cost=1
  ptype_choice=$(read_input " ${BOLD}Select:${RESET} ")
  ptype_choice=$(printf '%s' "$ptype_choice" | tr -d '[:space:]')
  ptype_label="$M_NORMAL"
  case "$ptype_choice" in
    2) extra_flags+=("$VS_FLAG"); ptype_label="$M_SIG"; cost=2 ;;
    3) extra_flags+=("$VS_FLAG"); ptype_label="${BRAND_NAME} PROTECTION"; cost=3 ;;
  esac
  if [ "$CREDITS" -lt "$cost" ]; then
    clear_screen
    box_top
    box_line "${YELLOW}Not enough credits${RESET}"
    box_mid
    box_line "Need: ${cost} credits"
    box_line "Have: ${CREDITS} credits"
    box_line ""
    box_line "Contact: ${CYAN}${ADMIN_TG}${RESET}"
    box_bot
    pause
    return
  fi
  local out_root="${STORAGE_ROOT:-/storage/emulated/0}/${OUTPUT_FOLDER}"
  if ! mkdir -p "$out_root" 2>/dev/null; then
    clear_screen; box_top; box_line "${RED}Cannot create output folder${RESET}"; box_bot; pause; return
  fi
  local apk_name apk_ext apk_base work_dir log_out
  apk_name=$(basename "$apk_path")
  apk_ext="${apk_name##*.}"
  apk_base="${apk_name%.*}"
  work_dir="${TMP_BASE}/protect_$$"
  rm -rf "$work_dir"
  mkdir -p "$work_dir"
  show_protect_progress 0; sleep 0.35
  show_protect_progress 1; sleep 0.35
  show_protect_progress 2; sleep 0.25
  log_out="${work_dir}/run.log"
  (
    cd "$DPT_RUNTIME" || exit 90
    if [ "${#extra_flags[@]}" -gt 0 ]; then
      java -jar "$DPT_JAR" -f "$apk_path" -o "$work_dir" "${extra_flags[@]}"
    else
      java -jar "$DPT_JAR" -f "$apk_path" -o "$work_dir"
    fi
  ) >"$log_out" 2>&1 &
  local eng_pid=$!
  show_protect_progress 3
  local waited=0
  while kill -0 "$eng_pid" 2>/dev/null; do
    sleep 0.4
    waited=$((waited+1))
    [ "$waited" -eq 4 ] && show_protect_progress 4
  done
  wait "$eng_pid"
  local status=$?
  if [ "$status" -ne 0 ]; then
    local reason
    reason=$(tail -n 5 "$log_out" 2>/dev/null | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g' | cut -c1-34)
    [ -z "$reason" ] && reason="Unknown error"
    clear_screen
    box_top
    box_line "${RED}${BOLD}✗ PROTECTION FAILED${RESET}"
    box_line "${BOLD}${MAGENTA}${BRAND_NAME}${RESET}"
    box_mid
    box_line "Reason: $reason"
    box_bot
    rm -rf "$work_dir"; pause; return
  fi
  show_protect_progress 5; sleep 0.25
  local produced final_path
  produced=$(find "$work_dir" -type f \( -name "*_signed.apk" -o -name "*.apk" -o -name "*.aab" \) ! -name "*_unsign*" -print 2>/dev/null | head -n1)
  if [ -z "$produced" ]; then
    clear_screen; box_top; box_line "${RED}No output file found${RESET}"; box_bot
    rm -rf "$work_dir"; pause; return
  fi
  final_path=$(unique_output_name "$out_root" "$apk_base" "$apk_ext")
  if ! mv "$produced" "$final_path"; then
    clear_screen; box_top; box_line "${RED}Could not save output${RESET}"; box_bot
    rm -rf "$work_dir"; pause; return
  fi
  rm -rf "$work_dir"
  CREDITS=$((CREDITS-cost))
  [ "$CREDITS" -lt 0 ] && CREDITS=0
  save_local_credits
  sync_to_firebase
  clear_screen
  box_top
  box_line "${GREEN}${BOLD}✓ PROTECTION COMPLETE${RESET}"
  box_line "${BOLD}${MAGENTA}${BRAND_NAME}${RESET}"
  box_line "${BOLD}${YELLOW}ADMIN${RESET}"
  box_mid
  box_line "${WHITE}${apk_name}${RESET}"
  box_line "Mode: ${CYAN}${ptype_label}${RESET}"
  box_line "Credits left: ${GREEN}${CREDITS}${RESET}"
  box_line "Saved to:"
  box_line "${DIM}${final_path}${RESET}"
  box_bot
  if [ "$CREDITS" -le 0 ]; then
    echo
    printf "  %s⚠ Credits khatam%s\n" "$YELLOW" "$RESET"
    printf "  %sContact: %s%s\n" "$DIM" "$ADMIN_TG" "$RESET"
  fi
  pause
}

require_config
main_menu
ENDOFDPT
